@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">Ocurrió un error</h1>
<p>No se pudo procesar tu solicitud. Vuelve a intentarlo.</p>
@if (Model.ShowRequestId)
{
    <p><strong>Identificador de la solicitud:</strong> <code>@Model.RequestId</code></p>
}
<a asp-controller="Home" asp-action="Index" class="btn btn-primary">Volver al inicio</a>
